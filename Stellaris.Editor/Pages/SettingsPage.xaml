<UserControl x:Class="Stellaris.Editor.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 内部导航栏（目录 / 语言 / 模组设置） -->
        <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Margin="4" Background="#FAFAFA">
            <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent" Padding="0"
                     SelectionChanged="OnNavChanged">
                <ListBoxItem x:Name="NavDirs" Padding="8,6" />
                <ListBoxItem x:Name="NavLang" Padding="8,6" />
                <ListBoxItem x:Name="NavMod" Padding="8,6" />
                <ListBoxItem x:Name="NavHelp" Padding="8,6" />
                <ListBoxItem x:Name="NavAbout" Padding="8,6" />
            </ListBox>
        </Border>

        <!-- 内容栏（目录面板撑满留帮助行；语言面板自适应） -->
        <ContentControl x:Name="ContentHost" Grid.Column="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
