<!-- 语言字典页：只读查询本地化条目（语种 + 键/值 正则匹配，点击搜索）。 -->
<UserControl x:Class="Stellaris.Editor.Pages.LanguageDictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 查询区：语种下拉 + 键/值下拉 + 一个输入框 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="LanguageCombo" Width="160" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock x:Name="FieldLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="FieldCombo" Width="100" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBox x:Name="PatternBox" Width="280" Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox x:Name="CaseSensitiveBox" VerticalAlignment="Center" Margin="0,0,12,0"
                      IsChecked="True" />
            <Button x:Name="SearchButton" Width="90" Padding="6,3" Click="OnSearch"
                    VerticalAlignment="Center" IsDefault="True" />
        </WrapPanel>

        <!-- 结果表格 -->
        <DataGrid x:Name="ResultGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" CanUserSortColumns="True"
                  Background="White" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="语言" Binding="{Binding Language}" Width="90" />
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*" />
                <DataGridTextColumn Header="显示值" Binding="{Binding DisplayValue}" Width="3*" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="DetailMenuItem" Click="OnShowDetail" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- 状态栏 -->
        <TextBlock x:Name="StatusText" Grid.Row="1" VerticalAlignment="Bottom"
                   Foreground="Gray" Margin="0,4,0,0" />
    </Grid>
</UserControl>
