<!-- 语言字典页：只读查询本地化条目。
     左列：语言导航（竖排——类似左侧导航栏：全部 + 各语言，点击切换只做本地过滤，无需重新搜索）。
     右列：选择类型（键/值）+ 搜索框 + 大小写 + 按钮（最顶一行）→ 结果表格 → 状态。 -->
<UserControl x:Class="Stellaris.Editor.Pages.LanguageDictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Stellaris.Editor.Pages">
    <UserControl.Resources>
        <pages:LanguageNameConverter x:Key="LangName" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 行0：选择类型 + 搜索（整页第一行全宽——输入框自然填满，长文本自动换行） -->
        <Grid Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="60" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FieldCombo" Width="100" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBox x:Name="PatternBox" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                     TextWrapping="Wrap" KeyDown="OnPatternBoxKeyDown" />
            <ToggleButton x:Name="CaseSensitiveBox" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                          IsChecked="True" Style="{StaticResource ToggleCheckStyle}" />
            <Button x:Name="SearchButton" Grid.Column="3" Padding="6,3" Click="OnSearch"
                    VerticalAlignment="Center" IsDefault="True" Style="{StaticResource SearchButtonStyle}" />
        </Grid>

        <!-- 行1：左语言导航 | 结果 | 右详情 -->
        <ListBox x:Name="LangNav" Grid.Row="1" Grid.Column="0" SelectionChanged="OnLangNavChanged"
                 Background="White" />

        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Width="3" Background="LightGray" />

        <!-- 中：结果 -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" CanUserSortColumns="True"
                      Background="White" RowHeaderWidth="0" SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="语言" Binding="{Binding Language, Converter={StaticResource LangName}}" Width="110" />
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*" />
                    <DataGridTextColumn Header="显示值" Binding="{Binding DisplayValue}" Width="3*" />
                </DataGrid.Columns>

            </DataGrid>

            <!-- 状态栏 -->
            <TextBlock x:Name="StatusText" VerticalAlignment="Bottom"
                       Foreground="Gray" Margin="0,4,0,0" />
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Width="3" Background="LightGray" />

        <!-- 详情面板（右侧——选中条目显示，参考加成字典） -->
        <ScrollViewer Grid.Row="1" Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DetailPanel" Margin="8,0,0,0" />
        </ScrollViewer>
    </Grid>
</UserControl>
