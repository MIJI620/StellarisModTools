<UserControl x:Class="Stellaris.Editor.Pages.GalaxyStylePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnPageSizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- 左：预览区（1:1 等比，边长 = min(高×80%, 宽×50%)；无边框，只底色 + 极坐标网格） -->
        <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Margin="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" Padding="8,4" />
                </Border>
                <Viewbox x:Name="PreviewBox" Stretch="Uniform" Margin="8">
                    <Canvas x:Name="PreviewCanvas" Width="300" Height="300" Background="#FCFCFC"
                            SnapsToDevicePixels="True" />
                </Viewbox>
            </DockPanel>
        </Border>

        <!-- 右：编辑区 -->
        <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" Margin="4">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExportSettingsButton" Grid.Column="0" Margin="0,0,4,0"
                            Padding="4,3" Click="OnExportSettings" />
                    <Button x:Name="NormalizeAllButton" Grid.Column="1" Margin="4,0" Padding="4,3"
                            Click="OnNormalizeAll" />
                    <Button x:Name="SaveAllButton" Grid.Column="2" Margin="4,0,0,0" Padding="4,3"
                            Click="OnSaveAll" />
                </Grid>

                <!-- 主区：样式列表（可拖拽调高） / 分隔条 / 选项卡内容 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="60" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="8*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StyleFilterBox" Margin="0,0,6,0" VerticalAlignment="Center"
                                     TextWrapping="Wrap" KeyDown="OnFilterBoxKeyDown" />
                            <Button x:Name="StyleFilterSearchButton" Grid.Column="1" Content="🔍" Click="OnStyleFilterSearch" Padding="6,2"
                                    VerticalAlignment="Center" Style="{StaticResource SearchButtonStyle}" />
                        </Grid>
                    <ListBox x:Name="StyleList" Grid.Row="1" SelectionMode="Extended" AllowDrop="True"
                             SelectionChanged="OnStyleSelected"
                             PreviewMouseLeftButtonDown="OnListMouseDown"
                             PreviewMouseMove="OnListMouseMove"
                             DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop" />
                    <!-- 拖拽插入线指示 -->
                    <Border x:Name="InsertIndicator" Grid.Row="1" Height="2" Background="#4A90D9"
                            Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </Grid>
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" Background="#D0D0D0"
                                  DragCompleted="OnListSplitterDragCompleted" />

                <!-- 底部：导出设置 / 全部规整化 / 保存（各占 1/3 水平空间） -->

                <!-- 下方：3 页选项卡（形状 / 其他 / 颜色） -->
                                    <TabControl Grid.Row="2" x:Name="ParamTabs" Margin="4,0,4,4">
                    <TabItem x:Name="TabShape">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ShapePanel" Margin="4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="TabOther">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OtherPanel" Margin="4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="TabColor">
                        <StackPanel x:Name="ColorPanel" Margin="4" />
                    </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
