<!-- 动态地图页：左预览 + 右编辑（参照星系样式布局）。
     右侧：顶部地图列表（动态+静态混合，拖拽排序）→ 下方选项卡（基础/结构/形状排序/容量） -->
<UserControl x:Class="Stellaris.Editor.Pages.DynamicMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnPageSizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- 左：预览区（套壳：显示当前地图形状 + 终止半径） -->
        <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" Margin="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" Padding="8,4" />
                </Border>
                <Viewbox x:Name="PreviewBox" Stretch="Uniform" Margin="8">
                    <Canvas x:Name="PreviewCanvas" Width="300" Height="300" Background="#FCFCFC"
                            SnapsToDevicePixels="True" />
                </Viewbox>
            </DockPanel>
        </Border>

        <!-- 右：编辑区 -->
        <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" Margin="4">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MapNormalizeButton" Grid.Column="0" Margin="0,0,4,0" Padding="4,3"
                            Click="OnMapNormalize" />
                    <Button x:Name="MapSaveButton" Grid.Column="1" Margin="4,0,0,0" Padding="4,3"
                            Click="OnMapSave" />
                </Grid>

                <!-- 主区：地图列表（可拖拽调高） / 分隔条 / 选项卡内容 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="60" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="8*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MapFilterBox" Margin="0,0,6,0" VerticalAlignment="Center"
                                     TextWrapping="Wrap" KeyDown="OnFilterBoxKeyDown" />
                            <Button x:Name="MapFilterSearchButton" Grid.Column="1" Content="🔍" Click="OnMapFilterSearch" Padding="6,2"
                                    VerticalAlignment="Center" Style="{StaticResource SearchButtonStyle}" />
                        </Grid>
                    <ListBox x:Name="MapList" Grid.Row="1" SelectionMode="Extended" AllowDrop="True"
                             SelectionChanged="OnMapSelected"
                             PreviewMouseLeftButtonDown="OnListMouseDown"
                             PreviewMouseMove="OnListMouseMove"
                             DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,1">
                                    <TextBlock Text="{Binding StarCount}" Foreground="#606060"
                                               DockPanel.Dock="Right" Margin="8,0,0,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="InsertIndicator" Grid.Row="1" Height="2" Background="#4A90D9"
                            Visibility="Collapsed" IsHitTestVisible="false" VerticalAlignment="Top" />
                    </Grid>
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" Background="#D0D0D0"
                                  DragCompleted="OnListSplitterDragCompleted" />

                <!-- 下方：选项卡（基础 / 结构 / 形状排序 / 容量） -->
                <!-- 底部：全部规整化 / 保存（参考样式页位置，不翻页） -->
                                    <TabControl Grid.Row="2" x:Name="MapTabs" Margin="4,0,4,4">
                    <TabItem x:Name="TabBasic">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BasicPanel" Margin="4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="TabOther">
                        <!-- 其他：地图键（重命名）+ 地图名本地化（各语言逻辑值/显示值，参考星系样式"其他"） -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OtherPanel" Margin="4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="TabShapes">
                        <!-- 样式总表：显示全部星系样式，勾选 = 该地图要的样式（supports_shape）；
                             可选中行（Ctrl/Shift 多选）、左键拖拽排序、右键取消勾选 -->
                        <Grid>
                            <ListBox x:Name="ShapeListBox" SelectionMode="Extended" AllowDrop="True"
                                     PreviewMouseLeftButtonDown="OnShapeListMouseDown"
                                     PreviewMouseMove="OnShapeListMouseMove"
                                     DragOver="OnShapeListDragOver" DragLeave="OnShapeListDragLeave"
                                     Drop="OnShapeListDrop">
                                <!-- 关键：项内容水平伸展填满列表宽，Dock=Right 的上限才能贴最右 -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 保持条目（按钮感）外观：勾选左、本地化名填充（超长被右列遮盖）、上限右 -->
                                        <DockPanel Margin="2,1">
                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding RowEnabled}"
                                                      DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CapacityText}" Foreground="{Binding CapacityBrush}"
                                                       DockPanel.Dock="Right" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="ShapeInsertIndicator" Height="2" Background="#4A90D9"
                                    Visibility="Collapsed" IsHitTestVisible="false" VerticalAlignment="Top" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TabCapacity">
                        <!-- 颜色：与星系样式"颜色"一致（形状填充色 / 网格色，存银河类别 galaxy.json） -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ColorPanel" Margin="4" />
                        </ScrollViewer>
                    </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
