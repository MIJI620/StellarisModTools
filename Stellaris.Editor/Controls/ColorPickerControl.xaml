<UserControl x:Class="Stellaris.Editor.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button Click="OnOpen" HorizontalAlignment="Stretch" Padding="4,2">
            <DockPanel>
                <Border x:Name="Swatch" Width="26" Height="18" BorderBrush="Gray" BorderThickness="1"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="HexText" Margin="6,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
        </Button>

        <!-- 选色面板：标题 → 选项卡（彩色 / 黑白）→ 底部右侧"确定"按钮 -->
        <Popup x:Name="ColorPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#999999" BorderThickness="1" Padding="10" CornerRadius="4">
                <Grid Width="360">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleText" Grid.Row="0" FontWeight="SemiBold" Margin="2,0,0,8" />

                    <!-- 选项卡：彩色（HSVA 面板）/ 黑白（灰阶） -->
                    <TabControl Grid.Row="1" x:Name="ModeTabs">
                        <TabItem x:Name="ColorTab">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>

                                <!-- 左：明度 V（顶部白 → 底部黑） -->
                                <Grid Grid.Column="0" Margin="0,6,8,0">
                                    <Border x:Name="ValueBar" CornerRadius="2" BorderBrush="#AAAAAA" BorderThickness="1" />
                                    <Slider x:Name="ValueSlider" Orientation="Vertical" Minimum="0" Maximum="1"
                                            ValueChanged="OnValueChanged" />
                                </Grid>

                                <!-- 中：色相 + 预览 + RGBA -->
                                <StackPanel Grid.Column="1" Margin="0,6,0,0">
                                    <Border x:Name="HueGradient" Height="12" CornerRadius="2" Margin="0,0,0,4" />
                                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" ValueChanged="OnHueChanged"
                                            Margin="0,0,0,10" />

                                    <Border x:Name="BigSwatch" Height="30" CornerRadius="2" BorderBrush="#AAAAAA"
                                            BorderThickness="1" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock x:Name="RLabel" FontSize="11" HorizontalAlignment="Center" />
                                            <TextBox x:Name="RBox" TextChanged="OnRgbChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                            <TextBlock x:Name="GLabel" FontSize="11" HorizontalAlignment="Center" />
                                            <TextBox x:Name="GBox" TextChanged="OnRgbChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                            <TextBlock x:Name="BLabel" FontSize="11" HorizontalAlignment="Center" />
                                            <TextBox x:Name="BBox" TextChanged="OnRgbChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock x:Name="ALabel" FontSize="11" HorizontalAlignment="Center" />
                                            <TextBox x:Name="ABox" TextChanged="OnRgbChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 右：透明度 A（顶部不透明 → 底部透明） -->
                                <Grid Grid.Column="2" Margin="8,6,0,0">
                                    <Border x:Name="AlphaBar" CornerRadius="2" BorderBrush="#AAAAAA" BorderThickness="1" />
                                    <Slider x:Name="AlphaSlider" Orientation="Vertical" Minimum="0" Maximum="255"
                                            ValueChanged="OnAlphaChanged" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="GrayTab">
                            <StackPanel Margin="6,10,6,4">
                                <Border x:Name="GraySwatch" Height="34" CornerRadius="2" BorderBrush="#AAAAAA"
                                        BorderThickness="1" Margin="0,0,0,14" />
                                <TextBlock x:Name="GrayTitle" FontSize="11" Margin="0,0,0,3" />
                                <Slider x:Name="GraySlider" Minimum="0" Maximum="255"
                                        ValueChanged="OnGrayValueChanged" Margin="0,0,0,12" />
                                <TextBlock x:Name="GrayAlphaLabel" FontSize="11" Margin="0,0,0,3" />
                                <Slider x:Name="GrayAlphaSlider" Minimum="0" Maximum="255"
                                        ValueChanged="OnGrayValueChanged" Margin="0,0,0,12" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- 底部：右侧"确定"按钮 -->
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="OkButton" DockPanel.Dock="Right" Width="88" Height="26"
                                Click="OnOk" IsDefault="True" />
                    </DockPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
