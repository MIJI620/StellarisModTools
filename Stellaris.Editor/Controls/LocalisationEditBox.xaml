<UserControl x:Class="Stellaris.Editor.Controls.LocalisationEditBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="280">
    <!-- 本地化统一组件（星系样式"其他"页风格）：边框 + 语种下拉 + 名称/描述（逻辑值可编辑 → 显示值只读）。
         5 处共用：星系样式 / 法令决议 / 战略资源 / 静态地图 / 动态地图。 -->
    <Border BorderBrush="#D0D0D0" BorderThickness="1" Margin="4" Padding="6" CornerRadius="2">
        <StackPanel>
            <ComboBox x:Name="LangCombo" HorizontalAlignment="Stretch" Margin="0,0,0,6" />

            <TextBlock x:Name="NameLogicalLabel" Foreground="Gray" Margin="0,4,0,0" />
            <TextBox x:Name="NameLogicalBox" TextWrapping="Wrap" Margin="0,1,0,4" VerticalContentAlignment="Center" />
            <TextBlock x:Name="NameDisplayLabel" Foreground="Gray" Margin="0,4,0,0" />
            <TextBlock x:Name="NameDisplayText" TextWrapping="Wrap" MaxHeight="60" Foreground="Gray" Margin="0,1,0,4" />

            <TextBlock x:Name="DescLogicalLabel" Foreground="Gray" Margin="0,4,0,0" />
            <TextBox x:Name="DescLogicalBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                     VerticalScrollBarVisibility="Auto" Margin="0,1,0,4" />
            <TextBlock x:Name="DescDisplayLabel" Foreground="Gray" Margin="0,4,0,0" />
            <TextBlock x:Name="DescDisplayText" TextWrapping="Wrap" MaxHeight="80" Foreground="Gray" Margin="0,1,0,4" />
        </StackPanel>
    </Border>
</UserControl>
