<Window x:Class="Stellaris.Editor.StatusOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Title="Stellaris Mod Tools" Width="400" Height="300">
    <!-- 规范 4.5：半透明白色背景、黑色文字、无边框、无系统控制、无拖动、固定居中。
         固定尺寸 400×300（宽×高），文本靠底部居中显示。 -->
    <Grid>
        <Border Background="#CCFFFFFF" BorderBrush="#9A9A9A" BorderThickness="1" CornerRadius="8">
            <Grid>
            <!-- 图标：上部空地填充固定大小、放大的最大尺寸 ICO（96 → 160，居中偏上） -->
            <Image Source="Resources/app_icon.png"
                   Width="160" Height="160" Stretch="Uniform"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80" />
            <!-- 文本区：位于底部；文本在标签内垂直居中 -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="28,0,28,36">
                <!-- 显示层固定 ≤3 行：CompactLines 已按字符数切成 块1/…/块N（每块短——不换行撑高）；
                     TextBox 只读——文本在标签内垂直居中 -->
                <TextBox x:Name="MainText" FontSize="14" Foreground="Black"
                         Background="Transparent" BorderThickness="0" IsReadOnly="True"
                         Focusable="False" TextAlignment="Center" VerticalContentAlignment="Center"
                         TextWrapping="Wrap" MaxHeight="59" />
                <TextBox x:Name="SubText" FontSize="12" Foreground="#505050"
                         Background="Transparent" BorderThickness="0" IsReadOnly="True"
                         Focusable="False" TextAlignment="Center" VerticalContentAlignment="Center"
                         TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="50" />
            </StackPanel>
            </Grid>
        </Border>
        <!-- 错误退出按钮（初始化失败时显示） -->
        <Button x:Name="ExitButton" Content="Exit" Width="96" Height="30"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                Visibility="Collapsed" Click="OnExit" />
    </Grid>
</Window>
