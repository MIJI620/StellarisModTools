<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ApplicationIcon Condition="Exists('../icon/群星模组工具.ico')">../icon/群星模组工具.ico</ApplicationIcon>
		<AssemblyName>群星模组工具</AssemblyName>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
		<PackageReference Include="SkiaSharp" Version="4.150.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Stellaris.Engine\Stellaris.Engine.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="localisation\**" CopyToOutputDirectory="PreserveNewest" />
		<Resource Include="../icon/群星模组工具_96x96.png" Link="Resources/app_icon.png"
		         Condition="Exists('../icon/群星模组工具_96x96.png')" />
	</ItemGroup>
</Project>