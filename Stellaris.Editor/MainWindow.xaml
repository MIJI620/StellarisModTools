<Window x:Class="Stellaris.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 左侧导航 -->
        <Border DockPanel.Dock="Left" Width="180" Background="#FAFAFA"
                BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding Selected}" DisplayMemberPath="Title"
                     BorderThickness="0" Background="Transparent" Padding="0" />
        </Border>

        <!-- 右侧导航驱动的页面容器（规范 5.1） -->
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
