<Window x:Class="Stellaris.Editor.RootsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roots" Width="560" Height="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <DockPanel Margin="12">
        <TextBlock x:Name="HintText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="LangLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="LangBox" Width="140" VerticalAlignment="Center" Margin="0,0,16,0"
                      SelectionChanged="OnLanguageChanged" />
            <TextBlock x:Name="ProfileLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ProfileBox" Width="220" VerticalAlignment="Center" SelectionChanged="OnProfileChanged" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Width="88" Margin="0,0,8,0" Click="OnOk" IsDefault="True" />
            <Button x:Name="CancelButton" Width="88" Click="OnCancel" IsCancel="True" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="RootsList" Grid.Column="0"
                     SelectionMode="Extended"
                     PreviewMouseRightButtonUp="OnListRightUp"
                     ToolTip="左键单选 / Ctrl+左键多选 / Shift+左键连选" />
        </Grid>
    </DockPanel>
</Window>
